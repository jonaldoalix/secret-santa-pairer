# Server
PORT=3024
MUSEUM_MODE=false
NOTIFY_PROVIDER=stub
SEED_MUSEUM_DEMO=false

# Event / message customization
GIFT_BUDGET=$25
EVENT_DATE=the 24th
EVENT_LABEL=Secret Santa
MESSAGE_LOCALE=bilingual
# MESSAGE_TEMPLATE_EN=Hello {santa}! Your recipient is {recipient}. Budget {budget}. See you {date}!
# MESSAGE_TEMPLATE_ES=¡Hola {santa}! Su asignación es {recipient}. Presupuesto {budget}. ¡Nos vemos {date}!

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS SNS SMS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SNS_SENDER_ID=

# Generic HTTP SMS webhook (openSMS-style template)
HTTP_SMS_URL=
HTTP_SMS_API_KEY=
HTTP_SMS_AUTH_HEADER=Authorization
